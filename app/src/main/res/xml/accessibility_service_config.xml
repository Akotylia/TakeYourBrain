<?xml version="1.0" encoding="utf-8"?>
<!--
    Настройки службы специальных возможностей.
    typeWindowStateChanged — узнаём, что открылось другое окно/приложение.
    События "содержимое окна изменилось" служба включает сама и только когда нужно
    (в открытом приложении заблокирована его часть, например YouTube Shorts).
    canRetrieveWindowContent и flagReportViewIds — можем найти на экране элемент по его id
    (например, плеер Shorts) и проверить, какое приложение в активном окне.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100" />
