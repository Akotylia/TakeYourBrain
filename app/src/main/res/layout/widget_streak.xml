<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет "Огонёк": значок и дни серии. Цвета берутся по теме телефона (values / values-night) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/widget_flame"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/streak_title"
        android:src="@drawable/ic_flame"
        android:tint="@color/widget_flame" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_streak_preview"
            android:textColor="@color/widget_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/streak_title"
            android:textColor="@color/widget_text_soft"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
